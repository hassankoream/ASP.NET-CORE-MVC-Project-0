@model RoleViewModel
@{
	ViewData["Title"] = "Edit";
}

<div class="row justify-content-center align-content-center mt-3">
	<h1 class="col-8 my-4">Create Role</h1>
	<form method="post" asp-controller="Role" asp-action="@ViewData["Title"]" class="col-8" enctype="multipart/form-data">
		<div asp-validation-summary="ModelOnly"></div>
		<div class="form-group mb-3">
			<label class="form-label" asp-for="Name"></label>
			<input asp-for="Name" class="form-control" />
			<span asp-validation-for="Name" class="text-danger"></span> @*Name is required*@
		</div>

		<h3>Assign Users to Roles </h3>

		<div class="from-group">
			@for(int i = 0; i< Model.Users.Count; i++)
			{
				<div class="form-check"> 

					<input type="hidden" asp-for="Users[i].UserId" />
					<input type="hidden" asp-for="Users[i].UserName" />

					<input asp-for= "Users[i].IsSelected" class="form-check-input" />
					<label class="from-check-label">@Model.Users[i].UserName</label>
				</div>

			}
		</div>



		<div class="mt-4 m-auto">
			<input class="btn btn-primary" type="submit" value="Edit" />
			<a asp-controller="Role" asp-action="Index" class="btn btn-outline-dark">Back to list</a>
		</div>






	</form>
</div>

