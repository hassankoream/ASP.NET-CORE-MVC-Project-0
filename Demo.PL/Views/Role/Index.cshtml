@model IEnumerable<RoleViewModel>
@{
	ViewData["Title"] = "Index";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>All Roles</h1>
<br />
<br />

<a class="btn btn-primary" asp-controller="Role" asp-action="Create">Create Role</a>
<div class="">
	<form class="row offset-2" asp-action="Index" method="get">
		<div class="col">
			<input class="form-control" type="text" name="SearchValue" placeholder="Search by User Email" />
		</div>
		<div class="col">
			<input type="submit" class="btn btn-outline-dark " value="search" />
		</div>
	</form>
</div>
@if (Model.Count() > 0)
{
	<table class="table table-striped table-hover mt-3">
		<thead class="text-center">
			<tr>
				<th>@Html.DisplayNameFor(R => R.Id)</th>
				<th>@Html.DisplayNameFor(R => R.Name)</th>


				<th>Details</th>
				<th>Update</th>
				<th>Delete</th>
			</tr>
		</thead>

		<tbody class="text-center">
			@foreach (var role in Model)
			{
				<tr>


					<td>@Html.DisplayFor(E => role.Id)</td>
					<td>@Html.DisplayFor(E => role.Name)</td>



					@{
						/*	@* 2nd Way*@
						@{
						Html.RenderPartial("_ButtonsPartial", @employee.Id);
						}
						@* 3rd Way *@
						@Html.Partial("_ButtonsPartial", @employee.Id); */
					}
					<partial name="_ButtonsPartial" model="@role.Id"></partial>


					@{
						/*<td>
						<a class="btn btn-primary" asp-controller="Employee" asp-action="Details" asp-route-id="@employee.Id">
						<i class="fas fa-eye"></i>    Details
						</a>
						</td>
						<td>
						<a class="btn btn-success" asp-controller="Employee" asp-action="Edit" asp-route-id="@employee.Id">
						<i class="fa-solid fa-pen-to-square"></i>    Edit
						</a>
						</td>
						<td>
						@* 	<a class="btn btn-danger" asp-controller="Employee" asp-action="Delete" asp-route-id="@employee.Id">
						<i class="fa-solid fa-trash"></i>   Delete
						</a> *@

						<button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
						<i class="fas fa-trash"></i> Delete
						</button>
						</td>*/
					}



				</tr>

				@* Delete Modal *@
				<div class="modal fade" id="deleteModal-@role.Id" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
					<div class="modal-dialog">
						<div class="modal-content">
							<div class="modal-header">
								<h1 class="modal-title fs-5" id="exampleModalLabel">Delete Role</h1>
								<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
							</div>
							<div class="modal-body">
								Are You Sure to Delete this Role?
							</div>
							<div class="modal-footer">
								<form asp-action="ConfirmDelete" asp-controller="Role" asp-route-id="@role.Id" class="mt-4">
									<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
									<input type="submit" value="Delete" class="btn btn-danger" />
								</form>
							</div>
						</div>
					</div>
				</div>
			}
		</tbody>
	</table>
}

else
{
	<div class="alert alert-info mt-3">
		<h2>No Roles Found!</h2>
	</div>
}

